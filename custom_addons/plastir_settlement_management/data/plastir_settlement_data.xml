<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tipos de Actividad Personalizados para Liquidaciones y Tránsito (Notificaciones) -->
        <record id="mail_act_settlement_eta" model="mail.activity.type">
            <field name="name">Seguimiento de Embarque / ETA</field>
            <field name="icon">fa-ship</field>
            <field name="res_model">plastir.settlement</field>
            <field name="delay_count">5</field>
            <field name="delay_unit">days</field>
            <field name="summary">Monitoreo de arribo a puerto / aduana</field>
        </record>

        <record id="mail_act_settlement_dga" model="mail.activity.type">
            <field name="name">Revisión DUA / Impuestos DGA</field>
            <field name="icon">fa-building</field>
            <field name="res_model">plastir.settlement</field>
            <field name="delay_count">2</field>
            <field name="delay_unit">days</field>
            <field name="summary">Validación de gravamen, arancel e ITBIS DUA</field>
        </record>

        <record id="mail_act_settlement_proration" model="mail.activity.type">
            <field name="name">Validación de Prorrateo Landed</field>
            <field name="icon">fa-calculator</field>
            <field name="res_model">plastir.settlement</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="summary">Comprobación de costos prorrateados por SKU</field>
        </record>

        <record id="mail_act_settlement_close" model="mail.activity.type">
            <field name="name">Cierre Mercancías en Tránsito</field>
            <field name="icon">fa-money</field>
            <field name="res_model">plastir.settlement</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="summary">Asiento contable definitivo y valorización</field>
        </record>

        <!-- Proveedor Internacional Oficial Plantilla -->
        <record id="partner_ningbo_topwin" model="res.partner">
            <field name="name">NINGBO TOPWIN CO., LTD</field>
            <field name="supplier_rank">1</field>
            <field name="is_company">1</field>
            <field name="country_id" ref="base.cn"/>
            <field name="comment">Proveedor internacional oficial de importación PLASTIR SRL</field>
        </record>

