<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_plastir_settlement" model="ir.module.category">
        <field name="name">Liquidación de Mercancías e Importaciones</field>
        <field name="description">Gestión de liquidaciones aduanales, prorrateo de costos landed y contabilidad de mercancías en tránsito.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_settlement_user" model="res.groups">
        <field name="name">Usuario de Liquidaciones</field>
        <field name="category_id" ref="module_category_plastir_settlement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_settlement_manager" model="res.groups">
        <field name="name">Administrador de Liquidaciones y Costos</field>
        <field name="category_id" ref="module_category_plastir_settlement"/>
        <field name="implied_ids" eval="[(4, ref('group_settlement_user')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user')), (4, ref('account.group_account_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Regla multi-compañía -->
    <record id="rule_plastir_settlement_multicompany" model="ir.rule">
        <field name="name">Liquidaciones Multi-Compañía</field>
        <field name="model_id" ref="model_plastir_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
