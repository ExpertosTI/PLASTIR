<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plastir_settlement_import_wizard_form" model="ir.ui.view">
        <field name="name">plastir.settlement.import.wizard.form</field>
        <field name="model">plastir.settlement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar Liquidación desde Plantilla Excel">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Formatos Compatibles:</strong>
                        <ul class="mb-0 mt-1">
                            <li><strong>Plantilla Oficial PLASTIR SRL:</strong> Archivo con pestañas <em>'Facturas y gastos'</em> y <em>'Mercancias'</em> (descuentos, fletes, comisiones, tributos DGA, ITBIS).</li>
                            <li><strong>Modelo Simplificado:</strong> Archivo directo con columnas de <em>FOB, Seguro, Flete, Gravamen, ISC, ITBIS, Aduana, Transporte, etc.</em></li>
                        </ul>
                    </div>
                    <group>
                        <group>
                            <field name="settlement_id" readonly="1"/>
                            <field name="excel_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="auto_create_products"/>
                            <field name="auto_compute_proration"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Procesar e Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_plastir_settlement_import_wizard" model="ir.actions.act_window">
        <field name="name">Cargar Liquidación desde Excel</field>
        <field name="res_model">plastir.settlement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
